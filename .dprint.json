{
  "indentWidth": 4,
  "lineWidth": 100,
  "includes": [
    "**/*.json",
    "**/*.toml",
    "**/*.yaml",
    "**/*.yml",
    "**/*.md"
  ],
  "excludes": [
    "target/**/*",
    "target-fix/**/*",
    ".git/**/*",
    ".direnv/**/*",
    ".devenv/**/*",
    "*.lock"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.19.0.wasm",
    "https://plugins.dprint.dev/toml-0.6.0.wasm",
    "https://plugins.dprint.dev/yaml-0.1.1.wasm",
    "https://plugins.dprint.dev/markdown-0.17.8.wasm"
  ]
}
